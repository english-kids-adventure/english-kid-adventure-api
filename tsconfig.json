{
  "compilerOptions": {
    "module": "ESNext",
   "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": "src",
    "paths": {
      "@config/*": ["config/*"],
      "@constants/*": ["constants/*"],
      "@modules/*": ["modules/*"],
      "@utils/*": ["utils/*"],
      "@middlewares/*": ["middlewares/*"]
    },
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"],
  "outDir": "dist",
}
